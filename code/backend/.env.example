NODE_ENV=development
PORT=3000

# Database Config (To be used by Prisma later)
DATABASE_URL="postgresql://postgres:password@localhost:5432/umicv?schema=public"

# Redis Config (To be used by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Config
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
